{
	"name": "lazyforeman",
	"version": "0.1.0",
	"type": "module",
	"description": "Multi-agent orchestration framework - you describe the requirement, it does the work, you get the result",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"format": "biome format --write .",
