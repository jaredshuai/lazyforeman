		"type": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.19.1",
		"typescript": "6.0.3",
		"vite": "8.2.2",
		"vitest": "5.0.0"
	},
	"dependencies": {
		"@dbos-inc/dbos-sdk": "^5.2.11",
		"better-sqlite3": "^13.0.3",
		"zod": "^4.6.5"
